{
  "name": "burro-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:student": "pnpm --filter @burro/student dev",
    "dev:parent": "pnpm --filter @burro/parent dev",
    "dev:admin": "pnpm --filter @burro/admin dev",
    "build": "pnpm -r build",
    "build:student": "pnpm --filter @burro/student build",
    "build:parent": "pnpm --filter @burro/parent build",
    "build:admin": "pnpm --filter @burro/admin build",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}